{
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "kind",
    "category",
    "origin",
    "cost",
    "text",
    "strength",
    "weakness",
    "visual",
    "media"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "kind": {
      "enum": [
        "character",
        "ref"
      ]
    },
    "category": {
      "enum": [
        "cinema",
        "series",
        "politique",
        "anime",
        "musique",
        "jeu_video",
        "internet"
      ]
    },
    "origin": {
      "type": "object",
      "required": [
        "work",
        "year",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "work": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "minItems": 1
        }
      }
    },
    "cost": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "stats": {
      "type": "object",
      "required": [
        "hp"
      ],
      "additionalProperties": false,
      "properties": {
        "hp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "strength": {
      "type": "string",
      "minLength": 1
    },
    "weakness": {
      "type": "string",
      "minLength": 1
    },
    "visual": {
      "enum": [
        "subtitle",
        "pixel",
        "scroll",
        "powder",
        "spotlight",
        "rewind",
        "pulse"
      ]
    },
    "media": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "abilities": {
      "type": "object",
      "required": [
        "effect"
      ],
      "additionalProperties": false,
      "properties": {
        "effect": {
          "type": "object",
          "required": [
            "type",
            "amount"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "attack",
                "heal",
                "shield"
              ]
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            }
          }
        }
      }
    },
    "synergy": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "character_id",
        "bonus"
      ],
      "additionalProperties": false,
      "properties": {
        "character_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "bonus": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Battle Ref Arena — Carte",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "character"
          }
        }
      },
      "then": {
        "required": [
          "stats"
        ],
        "properties": {
          "abilities": false,
          "synergy": false
        }
      },
      "else": {
        "required": [
          "abilities",
          "synergy"
        ],
        "properties": {
          "stats": false,
          "cost": {
            "minimum": 1
          }
        }
      }
    }
  ]
}
