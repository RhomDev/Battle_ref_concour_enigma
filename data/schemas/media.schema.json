{
  "type": "object",
  "required": [
    "id",
    "kind",
    "creator",
    "license",
    "status",
    "restrictions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "kind": {
      "enum": [
        "image",
        "video",
        "gif",
        "audio",
        "mixed"
      ]
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "sourceNote": {
      "type": "string",
      "minLength": 1
    },
    "creator": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "enum": [
        "CC-BY-2.0",
        "CC-BY-3.0",
        "CC0-1.0",
        "PD-USGov",
        "PDM-1.0",
        "authorization-required",
        "unverified",
        "CC-BY-SA-2.0",
        "CC-BY-SA-3.0",
        "CC-BY-SA-4.0"
      ]
    },
    "status": {
      "enum": [
        "demo_asset",
        "reference_only"
      ]
    },
    "restrictions": {
      "type": "string",
      "minLength": 1
    },
    "localPath": {
      "type": "string",
      "pattern": "^asset/(?:image/catalogue|sound|gif|video)/[a-z][a-z0-9_-]*\\.(?:webp|png|gif|mp4|mp3)$"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000
    },
    "localCopies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/localCopy" }
    },
    "focalPoint": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "caption": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Battle Ref Arena — Média",
  "$defs": {
    "localCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "localPath", "assetUrl", "caption"],
      "properties": {
        "kind": { "enum": ["image", "audio", "gif", "video"] },
        "localPath": { "$ref": "#/properties/localPath" },
        "assetUrl": { "$ref": "#/properties/sourceUrl" },
        "caption": { "$ref": "#/properties/caption" },
        "durationMs": { "$ref": "#/properties/durationMs" }
      },
      "oneOf": [
        { "properties": { "kind": { "const": "image" }, "localPath": { "pattern": "\\.(webp|png)$" } } },
        { "required": ["durationMs"], "properties": { "kind": { "const": "audio" }, "localPath": { "pattern": "\\.mp3$" } } },
        { "required": ["durationMs"], "properties": { "kind": { "const": "gif" }, "localPath": { "pattern": "\\.gif$" } } },
        { "required": ["durationMs"], "properties": { "kind": { "const": "video" }, "localPath": { "pattern": "\\.mp4$" } } }
      ]
    }
  },
  "anyOf": [
    { "required": ["sourceUrl"] },
    { "required": ["sourceNote"], "properties": { "status": { "const": "demo_asset" } } }
  ],
  "if": {
    "properties": {
      "status": {
        "const": "demo_asset"
      }
    }
  },
  "then": {
    "required": [
      "localPath"
    ],
    "not": { "required": ["localCopies"] },
    "properties": {
      "license": {
        "enum": [
          "CC-BY-2.0",
          "CC-BY-3.0",
          "CC0-1.0",
          "PD-USGov",
          "PDM-1.0",
          "CC-BY-SA-2.0",
          "CC-BY-SA-3.0",
          "CC-BY-SA-4.0"
        ]
      }
    },
    "allOf": [
      {
        "if": { "properties": { "kind": { "const": "audio" } } },
        "then": {
          "required": ["durationMs"],
          "properties": { "localPath": { "pattern": "\\.mp3$" } }
        }
      },
      {
        "if": { "properties": { "kind": { "const": "gif" } } },
        "then": {
          "required": ["durationMs"],
          "properties": { "localPath": { "pattern": "\\.gif$" } }
        }
      }
    ]
  },
  "else": {
    "not": {
      "required": [
        "localPath"
      ]
    }
  }
}
